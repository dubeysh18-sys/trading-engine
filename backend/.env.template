# ─────────────────────────────────────────────
#  Trading Rule Engine — Environment Variables
# ─────────────────────────────────────────────

# Upstox Access Token (valid for ~1 year, no refresh needed)
UPSTOX_ACCESS_TOKEN=PASTE_YOUR_TOKEN_HERE

# (Optional) Upstox API credentials — only needed if you ever regenerate the token
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback

# Database path (SQLite)
DATABASE_URL=sqlite:///./trading.db

# App settings
APP_ENV=production
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
